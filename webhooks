"""
WhatsApp Webhook for Twilio Sandbox Integration
========================================

Riceve messaggi da Twilio WhatsApp Sandbox, instrada al TriageController,
e restituisce risposte in XML TwiML (Twilio Markup Language).

Session management: based su numero telefono (From parameter)
"""

import logging
from typing import Dict, Tuple
from flask import Blueprint, request, Response
from twilio.twiml.messaging_response import MessagingResponse

# Importa il controller di Siraya
from siraya.controllers.triage_controller_v3 import get_triage_controller
from siraya.core.state_manager import get_state_manager, StateKeys

logger = logging.getLogger(__name__)

# Blueprint per separare le route
whatsapp_bp = Blueprint('whatsapp', __name__, url_prefix='/whatsapp')

# Session storage (in produzione: usare Redis/DB)
# Mappa: phone_number → session_id
_session_cache: Dict[str, str] = {}


class WhatsAppSessionManager:
    """Gestisce le sessioni WhatsApp basate su numero di telefono."""
    
    @staticmethod
    def get_or_create_session(phone_number: str) -> str:
        """
        Recupera o crea una nuova sessione per il numero di telefono.
        In produzione, usare Redis per persistenza tra deploy.
        """
        if phone_number not in _session_cache:
            # Crea nuova sessione
            import uuid
            session_id = str(uuid.uuid4())
            _session_cache[phone_number] = session_id
            logger.info(f"✅ Nuova sessione WhatsApp: {phone_number} → {session_id}")
        else:
            session_id = _session_cache[phone_number]
        
        return session_id


@whatsapp_bp.route('/message', methods=['POST'])
def handle_message() -> Response:
    """
    Endpoint POST per ricevere messaggi da Twilio WhatsApp.
    
    Twilio invia un multipart form-data con:
    - From: numero WhatsApp del client (es: whatsapp:+39123456789)
    - Body: testo del messaggio
    - SmsMessageSid: ID univoco del messaggio
    - AccountSid: ID account Twilio
    
    Response: XML TwiML con messaggio di risposta
    """
    try:
        # ═══ 1. Estrai parametri Twilio ═══
        from_phone = request.form.get('From', '').strip()
        user_message = request.form.get('Body', '').strip()
        message_sid = request.form.get('SmsMessageSid', 'unknown')
        
        logger.info(f"📨 WhatsApp message ricevuto: {from_phone} → '{user_message[:60]}...'")
        
        # Validazione input
        if not from_phone or not user_message:
            logger.warning("⚠️ Missing From or Body parameter")
            return _build_error_response("Errore: parametri mancanti")
        
        # ═══ 2. Ottieni o crea sessione ═══
        session_id = WhatsAppSessionManager.get_or_create_session(from_phone)
        
        # ═══ 3. Configura lo state con la sessione ═══
        state_manager = get_state_manager()
        state_manager.set(StateKeys.SESSION_ID, session_id)
        state_manager.set("_whatsapp_phone", from_phone)
        state_manager.set("_whatsapp_message_sid", message_sid)
        
        # ═══ 4. Processa il messaggio con il TriageController ═══
        controller = get_triage_controller()
        
        logger.info(f"🤖 Procesing input: '{user_message}'")
        response_data = controller.process_user_input(user_message)
        
        # ═══ 5. Estrai la risposta ═══
        assistant_response = response_data.get('assistant_response', 'Scusa, non ho capito.')
        
        # ═══ 6. Costruisci TwiML e riporta ═══
        logger.info(f"✅ Response generata: '{assistant_response[:60]}...'")
        
        return _build_twilio_response(assistant_response)
    
    except Exception as e:
        logger.error(f"❌ WhatsApp webhook error: {e}", exc_info=True)
        return _build_error_response(f"Errore interno: {str(e)[:100]}")


def _build_twilio_response(message_text: str) -> Response:
    """Costruisce una risposta TwiML per Twilio."""
    resp = MessagingResponse()
    resp.message(message_text)
    
    return Response(str(resp), mimetype='application/xml')


def _build_error_response(error_msg: str) -> Response:
    """Costruisce una risposta di errore TwiML."""
    resp = MessagingResponse()
    resp.message(error_msg)
    
    return Response(str(resp), mimetype='application/xml')


# Health check endpoint (per monitoraggio / Cloud PaaS)
@whatsapp_bp.route('/health', methods=['GET'])
def health_check() -> Tuple[Dict, int]:
    """Endpoint di health check per Render/Railway."""
    return {
        "status": "healthy",
        "service": "SIRAYA WhatsApp Webhook",
        "sessions": len(_session_cache)
    }, 200
